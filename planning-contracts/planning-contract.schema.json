{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://diversive.local/schemas/planning-contract.schema.json",
  "title": "Planning Contract Set",
  "description": "The Planning Contract field of one use case, in machine-readable form. The sections are exactly those the Use Case Format defines — Intent, Plan, Operations with their Parameters and their Returns and errors, Planning rules, Reversal, Resolved plans — and nothing else. One file per use case; a use case may carry no contract, one, or several. Where none should ever be produced, planned is false and notPlanned states why in one line.",
  "type": "object",
  "required": [
    "useCase",
    "planned",
    "contracts"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "useCase": {
      "type": "object",
      "required": [
        "id",
        "name",
        "module",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^UC-\\d{2}-\\d{2}$"
        },
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "description": "Path to the use case JSON, relative to this file."
        },
        "featureRef": {
          "type": "string"
        }
      }
    },
    "planned": {
      "type": "boolean",
      "description": "false where no plan should ever be produced for this use case."
    },
    "notPlanned": {
      "type": "object",
      "description": "Required when planned is false.",
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "description": "One line. Why no plan can exist."
        },
        "requestsThatArriveHere": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/requestPhrase"
          }
        },
        "routeInsteadTo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "request",
              "goesTo"
            ],
            "additionalProperties": false,
            "properties": {
              "request": {
                "$ref": "#/definitions/requestPhrase"
              },
              "goesTo": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/contract"
      }
    }
  },
  "definitions": {
    "contract": {
      "type": "object",
      "required": [
        "contractId",
        "intent",
        "plan",
        "operations",
        "planningRules",
        "reversal",
        "resolvedPlans"
      ],
      "additionalProperties": false,
      "properties": {
        "contractId": {
          "type": "string",
          "pattern": "^UC-\\d{2}-\\d{2}-PC-\\d+$"
        },
        "intent": {
          "$ref": "#/definitions/intent"
        },
        "plan": {
          "$ref": "#/definitions/plan"
        },
        "operations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/operation"
          }
        },
        "planningRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/planningRule"
          }
        },
        "reversal": {
          "$ref": "#/definitions/reversal"
        },
        "resolvedPlans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/resolvedPlan"
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "name",
        "summary",
        "routesHere",
        "routesElsewhere"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$",
          "description": "Canonical dotted name, e.g. student.register."
        },
        "summary": {
          "type": "string"
        },
        "routesHere": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/requestPhrase"
          },
          "description": "Real requests that should route to this intent."
        },
        "routesElsewhere": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "request",
              "goesTo"
            ],
            "additionalProperties": false,
            "properties": {
              "request": {
                "$ref": "#/definitions/requestPhrase"
              },
              "goesTo": {
                "type": "string",
                "description": "Intent name, use case ID, or a plain statement that it is not offered."
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "steps",
        "onFailure",
        "atomicity"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/definitions/planStep"
          }
        },
        "onFailure": {
          "type": "string",
          "description": "What the controller does when a step fails."
        },
        "atomicity": {
          "type": "string",
          "description": "What has been written when a run stops part way."
        }
      }
    },
    "planStep": {
      "type": "object",
      "required": [
        "step",
        "operation",
        "inputs"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "operation": {
          "type": "string",
          "description": "Must match an operation name in this contract."
        },
        "inputs": {
          "type": "object",
          "description": "Resolvable references or literals. $request.x, $session.x, $stepN.x, or a literal value."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "name",
        "method",
        "path",
        "kind",
        "idempotent",
        "purpose",
        "parameters",
        "returns",
        "errors"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PATCH",
            "PUT",
            "DELETE"
          ]
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "read",
            "create",
            "update",
            "deactivate",
            "action"
          ]
        },
        "idempotent": {
          "type": "boolean",
          "description": "Whether the controller may safely repeat it."
        },
        "idempotencyKey": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required for a non-idempotent write."
        },
        "purpose": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/parameter"
          }
        },
        "returns": {
          "type": "object",
          "required": [
            "description",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "description"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/opError"
          }
        },
        "writesOnRead": {
          "type": "string",
          "description": "Where a read nevertheless writes something — an audit entry, for example. Stated so a stopped run is readable."
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "source",
        "required",
        "type",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "enum": [
            "request",
            "session",
            "step",
            "literal",
            "resolved"
          ],
          "description": "request: the instruction supplied the value. session: controller context supplies it and it may never be read from the request. step: an earlier response supplies it. literal: fixed in the plan. resolved: it is an entity id the parameter resolver obtains through the gateway's resolve door, from a phrase in the request — the plan never contains a lookup step of its own."
        },
        "sourceRef": {
          "type": "string",
          "description": "$request.x, $session.x, $stepN.x, or the literal value."
        },
        "required": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "resolves": {
          "type": "object",
          "description": "Required when source is resolved. Declares what the parameter resolver asks the resolve door for, and what happens when the answer is not one thing.",
          "required": [
            "entityType",
            "fromPhrase",
            "onNoMatch",
            "onAmbiguous"
          ],
          "additionalProperties": false,
          "properties": {
            "entityType": {
              "type": "string",
              "description": "The kind of thing being resolved — module, dashboard_figure, guardian, class_section."
            },
            "fromPhrase": {
              "type": "string",
              "description": "The $request.<field> whose words are handed to resolve. The actor's own words, in whatever language they used."
            },
            "onNoMatch": {
              "type": "string",
              "description": "What the orchestrator does when nothing matches — refuse, or ask. Not a plan branch: the plan never ran."
            },
            "onAmbiguous": {
              "type": "string",
              "description": "What it does when more than one matches. Usually a question naming the candidates."
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "opError": {
      "type": "object",
      "required": [
        "code",
        "mapsTo",
        "httpStatus",
        "meaning",
        "written"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "mapsTo": {
          "type": [
            "string",
            "null"
          ],
          "description": "The E-id in the use case that defines this failure, or null where none does."
        },
        "httpStatus": {
          "type": "integer"
        },
        "meaning": {
          "type": "string"
        },
        "written": {
          "type": "string",
          "description": "What has been written when this arrives."
        },
        "notWritten": {
          "type": "string"
        },
        "treatedAsSuccess": {
          "type": "boolean",
          "description": "Returned on the success path; the controller reports the outcome rather than a failure."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "planningRule": {
      "type": "object",
      "required": [
        "id",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PR-\\d+$"
        },
        "rule": {
          "type": "string",
          "description": "Binds the planner, not the controller. Name the mistake."
        },
        "derivedFrom": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "BR-, AC-, E- or convention names in the use case this rule follows from."
        }
      }
    },
    "reversal": {
      "type": "object",
      "required": [
        "exists",
        "statement"
      ],
      "additionalProperties": false,
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "statement": {
          "type": "string"
        }
      }
    },
    "resolvedPlan": {
      "type": "object",
      "required": [
        "request",
        "steps",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/definitions/requestPhrase"
        },
        "context": {
          "type": "string",
          "description": "The session context this run assumes — role, branch, academic session."
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/planStep"
          }
        },
        "outcome": {
          "type": "string"
        }
      }
    },
    "requestPhrase": {
      "description": "A request in the actor's own words. A plain string is English. Use the object form for Roman Urdu or a code-switched sentence, and give a gloss so a reviewer who does not read Urdu can still check the routing.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "text",
            "lang",
            "gloss"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "description": "The request as it would actually be typed or spoken."
            },
            "lang": {
              "enum": [
                "en",
                "ur-Latn",
                "ur",
                "mixed"
              ],
              "description": "ur-Latn is Urdu written in Latin script, English nouns inside an Urdu sentence included. ur is Urdu script, which reaches the system but cannot be matched against records stored in Latin script. mixed is a sentence built half in each."
            },
            "gloss": {
              "type": "string",
              "description": "Plain English meaning. Required for anything that is not en."
            }
          }
        }
      ]
    }
  }
}
