# Local development settings for the AI layer POC.
#
#   cp .env.example .env        (or: make env)
#
# Every value here is a safe local default. The Makefile loads .env into the
# environment of every command, so the backend, the AI layer and Docker all
# read the same file. Keep lines as plain KEY=value (no quotes, no spaces).

# ---------------------------------------------------------------------------
# Postgres 16 + pgvector (docker/docker-compose.yml)
# ---------------------------------------------------------------------------
POSTGRES_HOST_PORT=5433
POSTGRES_DB=sms
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password

# ---------------------------------------------------------------------------
# Embeddings service (docker compose profile "embeddings", make embeddings-up)
# BGE-M3 served by Hugging Face Text Embeddings Inference, ~3 GB of memory.
# ---------------------------------------------------------------------------
EMBEDDINGS_HOST_PORT=8083

# ---------------------------------------------------------------------------
# Backend (Spring Boot, port 8080)
# The backend role owns the "school" schema: all business data.
# ---------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
BACKEND_DB_HOST=localhost
BACKEND_DB_PORT=5433
BACKEND_DB_NAME=sms
BACKEND_DB_USER=sms_backend
BACKEND_DB_PASSWORD=backend_dev_password
# POC stand-in for sign-in: "Authorization: Bearer <token>" acts as this user.
BACKEND_DEV_USER_TOKEN=local-dev-token-change-me
BACKEND_DEV_USERNAME=sana.iqbal
# Signs preflight tokens (at least 32 characters). Empty = a random key each start, so a
# confirmation does not survive a backend restart. Never commit a real one.
BACKEND_AGENT_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# AI layer (FastAPI, port 8081)
# The AI layer role owns only the "ai_layer" schema (the capability index)
# and has no privilege at all on business data (CLAUDE.md invariant 1).
# ---------------------------------------------------------------------------
AI_LAYER_HOST=127.0.0.1
AI_LAYER_PORT=8081
AI_LAYER_LOG_LEVEL=INFO
AI_LAYER_LOG_FORMAT=console
AI_LAYER_BACKEND_BASE_URL=http://127.0.0.1:8080
AI_LAYER_BACKEND_TIMEOUT_SECONDS=5
AI_LAYER_INDEX_DB_HOST=localhost
AI_LAYER_INDEX_DB_PORT=5433
AI_LAYER_INDEX_DB_NAME=sms
AI_LAYER_INDEX_DB_USER=sms_ai_layer
AI_LAYER_INDEX_DB_PASSWORD=ai_layer_dev_password
AI_LAYER_INDEX_DB_POOL_MIN_SIZE=1
AI_LAYER_INDEX_DB_POOL_MAX_SIZE=5
AI_LAYER_INDEX_AUTO_MIGRATE=true
AI_LAYER_EMBEDDINGS_BASE_URL=http://127.0.0.1:8083
AI_LAYER_EMBEDDINGS_TIMEOUT_SECONDS=60
AI_LAYER_METADATA_SYNC_ENABLED=true
AI_LAYER_METADATA_SYNC_INTERVAL_SECONDS=30
AI_LAYER_RETRIEVAL_CANDIDATE_CAP=30
AI_LAYER_RETRIEVAL_RRF_K=60
AI_LAYER_RETRIEVAL_BRANCH_LIMIT=50
# Decompose and plan call the Gemini API (gemini-3.1-flash-lite, pinned in app/llm/runner.py).
# Put a key from Google AI Studio here. Empty: POST /chat is off, and readiness says why.
# A free-tier key's requests may be used by Google to improve its products; a paid one's are not.
AI_LAYER_GEMINI_API_KEY=
AI_LAYER_MODEL_TIMEOUT_SECONDS=120
AI_LAYER_PLAN_MAX_STEPS=3
# Chat: an unanswered question or confirmation is forgotten after this long; plans for repeated
# sentences are remembered (0 turns the plan cache off)
AI_LAYER_CHAT_SESSION_TTL_SECONDS=1800
AI_LAYER_PLAN_CACHE_SIZE=256
# GET http://127.0.0.1:8081/ serves a page for trying the chat by hand (a developer tool)
AI_LAYER_CHAT_PAGE_ENABLED=true
# POST /chat with "trace": true also returns what each pipeline stage got and produced (the page's pipeline view)
AI_LAYER_CHAT_TRACE_ENABLED=true
