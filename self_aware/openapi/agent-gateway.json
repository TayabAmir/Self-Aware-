            "description" : "OK"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "Unauthorized"
          }
        },
        "tags" : [ "agent-metadata-controller" ]
      }
    },
    "/agent/metadata/versions" : {
