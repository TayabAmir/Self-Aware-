  "info" : {
    "description" : "The only endpoints the AI layer calls. Plans name capability ids, never URLs.",
    "title" : "School backend: agent gateway",
    "version" : "0.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/agent/execute" : {
      "post" : {
        "operationId" : "execute",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ExecuteRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ExecuteResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "INVALID_PLAN"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "TOKEN_INVALID, NOT_PERMITTED"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "TOKEN_EXPIRED, STALE_VERSION"
          },
          "501" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "NOT_IMPLEMENTED"
          }
        },
        "tags" : [ "execute-controller" ]
      }
    },
    "/agent/metadata" : {
      "get" : {
        "operationId" : "metadata",
