            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "Unauthorized"
          }
        },
        "tags" : [ "agent-metadata-controller" ]
      }
    },
    "/agent/preflight" : {
      "post" : {
        "operationId" : "preflight",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PreflightRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PreflightResponse"
                }
              }
            },
            "description" : "OK"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "INVALID_PLAN"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "UNAUTHENTICATED"
          },
          "403" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "NOT_PERMITTED"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "STALE_VERSION"
          },
          "422" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "NOT_FOUND, AMBIGUOUS_ENTITY, PRECONDITION_FAILED"
          },
          "501" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "NOT_IMPLEMENTED"
          }
        },
        "tags" : [ "preflight-controller" ]
      }
    },
    "/agent/session/capabilities" : {
      "get" : {
        "operationId" : "capabilities",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionCapabilitiesResponse"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AgentErrorResponse"
                }
              }
            },
            "description" : "Unauthorized"
          }
        },
        "tags" : [ "agent-session-controller" ]
      }
    }
  },
  "servers" : [ {
    "description" : "Local development",
    "url" : "http://localhost:8080"
  } ]
}
