<?xml version="1.0" encoding="UTF-8"?>
<!--
  Backend build: two modules with a one-way dependency.

    agent-gateway  generic and reusable. Annotations, registry, preflight, execute.
                   Knows nothing about schools, fees or students.
    school-app     the runnable Spring Boot application: business modules
                   (fee, student, academic), database migrations, and wiring.

  school-app depends on agent-gateway, never the reverse, so the gateway
  stays general and the school-specific parts stay in one place.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.diversive</groupId>
    <artifactId>backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>backend-parent</name>
    <description>School backend with the agent gateway (AI layer POC)</description>

    <modules>
        <module>agent-gateway</module>
        <module>school-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.diversive</groupId>
                <artifactId>agent-gateway</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-common</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
